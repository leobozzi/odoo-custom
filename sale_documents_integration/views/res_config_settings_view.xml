<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit the config settings view for added fields. #T6320 -->
    <record
        id="res_config_settings_view_form_inherited_sale_documents_integration"
        model="ir.ui.view"
    >
        <field name="name">
            res.config.settings.view.form.inherit.sale_documents_integration
        </field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70" />
        <field name="inherit_id" ref="documents.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!-- Added fields related to sale order configuration. #T6320 -->
             <xpath expr="//app[@name='documents']" position="inside">
                <div class="row mt16 o_settings_container">
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="documents_sale_order_settings" />
                        </div>
                        <div class="o_setting_right_pane o_documents_right_pane">
                            <label for="documents_sale_order_settings" />
                            <span
                                class="fa fa-lg fa-building-o"
                                title="Values set here are company-specific."
                                aria-label="Values set here are company-specific."
                                groups="base.group_multi_company"
                                role="img"
                            />
                            <div class="row">
                                <div class="text-muted col-md-12">
                                    Centralize files attached to Sale Order
                                </div>
                            </div>
                            <div
                                class="content-group"
                                invisible="documents_sale_order_settings == False"
                            >
                                <div class="row mt16">
                                    <label
                                        class="o_form_label col-lg-3"
                                        for="sale_order_folder_id"
                                        string="Workspace"
                                    />
                                    <field
                                        name="sale_order_folder_id"
                                        required="documents_sale_order_settings == True"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
