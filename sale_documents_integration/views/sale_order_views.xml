<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- inherited sale order form view for adding smart button. #T6320 -->
    <record id="sale_documents_integration_view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.documents.integration.view.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <!-- Added new smart button to show documents #T6320-->
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <field name="sale_document_count" invisible="1" />
                <button
                    name="action_sale_open_documents"
                    class="oe_stat_button"
                    icon="fa-file-text"
                    type="object"
                >
                    <field
                        name="sale_document_count"
                        widget="statinfo"
                        string="Documents"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
