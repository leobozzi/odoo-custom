<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Added new data for sale order ticket document folder. #T6320 -->
        <record
            id="sale_documents_integration_sale_documents_folder"
            model="documents.folder"
        >
            <field name="name">Sale Order</field>
            <field name="description" type="html">
                <center>
                    <p>
                        Categorize, share and keep track of all your Sale Orders
                        documents.
                    </p>
                </center>
            </field>
            <field name="sequence">1</field>
        </record>

        <record id="base.main_company" model="res.company">
            <field
                name="sale_order_folder_id"
                ref="sale_documents_integration_sale_documents_folder"
            />
        </record>
    </data>
</odoo>
